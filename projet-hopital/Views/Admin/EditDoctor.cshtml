@model projet_hopital.ViewModels.EditDoctorViewModel
@{
    ViewData["Title"] = "Modifier le médecin";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Tableau de bord</a></li>
            <li class="breadcrumb-item"><a asp-action="Doctors">Médecins</a></li>
            <li class="breadcrumb-item active">Modifier</li>
        </ol>
    </nav>
    <h1><i class="bi bi-pencil-square me-2"></i>Modifier le médecin</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="EditDoctor" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">Prénom</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">Nom</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Specialization" class="form-label">Spécialisation</label>
                            <input asp-for="Specialization" class="form-control" />
                            <span asp-validation-for="Specialization" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label">Département</label>
                            <select asp-for="DepartmentId" asp-items="@(new SelectList(Model.Departments, "Id", "Name"))" class="form-select">
                                <option value="">-- Sélectionner --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Bio" class="form-label">Biographie</label>
                        <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Bio" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Téléphone</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="ConsultationFee" class="form-label">Frais de consultation (MAD)</label>
                            <input asp-for="ConsultationFee" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="ConsultationFee" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="YearsOfExperience" class="form-label">Années d'expérience</label>
                            <input asp-for="YearsOfExperience" type="number" class="form-control" />
                            <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label">URL de l'image</label>
                        <input asp-for="ImageUrl" class="form-control" />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="IsAvailable" />
                            <label asp-for="IsAvailable" class="form-check-label">Disponible pour les rendez-vous</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Services proposés</label>
                        <div class="row">
                            @foreach (var service in Model.AvailableServices)
                            {
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input type="checkbox" name="SelectedServiceIds" value="@service.Id" 
                                               class="form-check-input" id="service_@service.Id"
                                               @(Model.SelectedServiceIds.Contains(service.Id) ? "checked" : "")>
                                        <label class="form-check-label" for="service_@service.Id">@service.Name</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Doctors" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Retour
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Enregistrer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

