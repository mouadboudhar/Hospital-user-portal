@model projet_hopital.ViewModels.AdminDoctorListViewModel
@{
    ViewData["Title"] = "Gestion des médecins";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-person-badge me-2"></i>Gestion des médecins</h1>
    <div>
        @if (Model.Doctors.Any(d => !d.IsAvailable))
        {
            <form asp-action="ActivateAllDoctors" method="post" class="d-inline">
                <button type="submit" class="btn btn-success me-2" onclick="return confirm('Activer tous les médecins indisponibles ?')">
                    <i class="bi bi-check-all me-1"></i>Activer tout
                </button>
            </form>
        }
        <a asp-action="CreateDoctor" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Nouveau médecin
        </a>
    </div>
</div>

@if (Model.Doctors.Any(d => !d.IsAvailable))
{
    <div class="alert alert-warning mb-4">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>Attention :</strong> @Model.Doctors.Count(d => !d.IsAvailable) médecin(s) ne sont pas visibles sur le portail utilisateur car ils sont marqués comme "Indisponible".
    </div>
}

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Rechercher</label>
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Nom ou spécialisation...">
            </div>
            <div class="col-md-4">
                <label class="form-label">Département</label>
                <select name="departmentId" class="form-select">
                    <option value="">Tous les départements</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.Id" selected="@(Model.DepartmentFilter == dept.Id)">@dept.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search me-1"></i>Filtrer
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Doctors Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Photo</th>
                        <th>Nom</th>
                        <th>Spécialisation</th>
                        <th>Département</th>
                        <th>Frais</th>
                        <th>Expérience</th>
                        <th>Disponible</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Doctors.Any())
                    {
                        @foreach (var doctor in Model.Doctors)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(doctor.ImageUrl))
                                    {
                                        <img src="@doctor.ImageUrl" alt="@doctor.FullName" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person text-white"></i>
                                        </div>
                                    }
                                </td>
                                <td><strong>@doctor.FullName</strong></td>
                                <td>@doctor.Specialization</td>
                                <td><span class="badge bg-info">@doctor.Department?.Name</span></td>
                                <td>@doctor.ConsultationFee.ToString("N2") MAD</td>
                                <td>@doctor.YearsOfExperience ans</td>
                                <td>
                                    <form asp-action="ToggleDoctorAvailability" asp-route-id="@doctor.Id" method="post" class="d-inline">
                                        @if (doctor.IsAvailable)
                                        {
                                            <button type="submit" class="btn btn-sm btn-success" title="Cliquer pour désactiver">
                                                <i class="bi bi-check-circle"></i> Disponible
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-danger" title="Cliquer pour activer">
                                                <i class="bi bi-x-circle"></i> Indisponible
                                            </button>
                                        }
                                    </form>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="EditDoctor" asp-route-id="@doctor.Id" class="btn btn-outline-primary" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" 
                                                onclick="confirmDelete(@doctor.Id, '@doctor.FullName')" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Aucun médecin trouvé</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer le médecin <strong id="doctorName"></strong> ?</p>
                <p class="text-danger"><small>Cette action est irréversible.</small></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form asp-action="DeleteDoctor" method="post" id="deleteForm">
                    <input type="hidden" name="id" id="deleteDoctorId" />
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteDoctorId').value = id;
            document.getElementById('doctorName').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}

