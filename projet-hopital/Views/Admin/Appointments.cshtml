@model projet_hopital.ViewModels.AdminAppointmentListViewModel
@{
    ViewData["Title"] = "Gestion des rendez-vous";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-calendar-check me-2"></i>Gestion des rendez-vous</h1>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Rechercher</label>
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Patient ou médecin...">
            </div>
            <div class="col-md-2">
                <label class="form-label">Statut</label>
                <select name="status" class="form-select">
                    <option value="">Tous</option>
                    <option value="0" selected="@(Model.StatusFilter == projet_hopital.Models.AppointmentStatus.Pending)">En attente</option>
                    <option value="1" selected="@(Model.StatusFilter == projet_hopital.Models.AppointmentStatus.Confirmed)">Confirmé</option>
                    <option value="2" selected="@(Model.StatusFilter == projet_hopital.Models.AppointmentStatus.Completed)">Terminé</option>
                    <option value="3" selected="@(Model.StatusFilter == projet_hopital.Models.AppointmentStatus.Cancelled)">Annulé</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Médecin</label>
                <select name="doctorId" class="form-select">
                    <option value="">Tous</option>
                    @foreach (var doctor in Model.Doctors)
                    {
                        <option value="@doctor.Id" selected="@(Model.DoctorFilter == doctor.Id)">@doctor.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Date début</label>
                <input type="date" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="form-control">
            </div>
            <div class="col-md-2">
                <label class="form-label">Date fin</label>
                <input type="date" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="form-control">
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Appointments Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Médecin</th>
                        <th>Service</th>
                        <th>Date</th>
                        <th>Heure</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Appointments.Any())
                    {
                        @foreach (var apt in Model.Appointments)
                        {
                            <tr>
                                <td><code>#@apt.Id</code></td>
                                <td>@apt.User?.FirstName @apt.User?.LastName</td>
                                <td>@apt.Doctor?.FullName</td>
                                <td>@(apt.Service?.Name ?? "-")</td>
                                <td>@apt.AppointmentDate.ToString("dd/MM/yyyy")</td>
                                <td>@apt.StartTime.ToString(@"hh\:mm") - @apt.EndTime.ToString(@"hh\:mm")</td>
                                <td>
                                    @switch (apt.Status)
                                    {
                                        case projet_hopital.Models.AppointmentStatus.Pending:
                                            <span class="badge bg-warning text-dark">En attente</span>
                                            break;
                                        case projet_hopital.Models.AppointmentStatus.Confirmed:
                                            <span class="badge bg-success">Confirmé</span>
                                            break;
                                        case projet_hopital.Models.AppointmentStatus.Completed:
                                            <span class="badge bg-info">Terminé</span>
                                            break;
                                        case projet_hopital.Models.AppointmentStatus.Cancelled:
                                            <span class="badge bg-danger">Annulé</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <div class="dropdown">
                                            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <form asp-action="UpdateAppointmentStatus" method="post">
                                                        <input type="hidden" name="id" value="@apt.Id" />
                                                        <input type="hidden" name="status" value="0" />
                                                        <button type="submit" class="dropdown-item">En attente</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="UpdateAppointmentStatus" method="post">
                                                        <input type="hidden" name="id" value="@apt.Id" />
                                                        <input type="hidden" name="status" value="1" />
                                                        <button type="submit" class="dropdown-item">Confirmer</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="UpdateAppointmentStatus" method="post">
                                                        <input type="hidden" name="id" value="@apt.Id" />
                                                        <input type="hidden" name="status" value="2" />
                                                        <button type="submit" class="dropdown-item">Terminer</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="UpdateAppointmentStatus" method="post">
                                                        <input type="hidden" name="id" value="@apt.Id" />
                                                        <input type="hidden" name="status" value="3" />
                                                        <button type="submit" class="dropdown-item text-danger">Annuler</button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                        <a asp-action="EditAppointment" asp-route-id="@apt.Id" class="btn btn-outline-primary" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" 
                                                onclick="confirmDelete(@apt.Id)" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Aucun rendez-vous trouvé</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer ce rendez-vous ?</p>
                <p class="text-danger"><small>Cette action est irréversible.</small></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form asp-action="DeleteAppointment" method="post" id="deleteForm">
                    <input type="hidden" name="id" id="deleteAppointmentId" />
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            document.getElementById('deleteAppointmentId').value = id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}

