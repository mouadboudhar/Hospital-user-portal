@model projet_hopital.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Tableau de bord Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-speedometer2 me-2"></i>Tableau de bord</h1>
    <span class="text-muted">@DateTime.Now.ToString("dddd, d MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</span>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-1 opacity-75">Utilisateurs</h6>
                        <h2 class="card-title mb-0">@Model.TotalUsers</h2>
                    </div>
                    <i class="bi bi-people fs-1 opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="@Url.Action("Users", "Admin")" class="text-white text-decoration-none small">
                    Gérer <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-1 opacity-75">Médecins</h6>
                        <h2 class="card-title mb-0">@Model.TotalDoctors</h2>
                    </div>
                    <i class="bi bi-person-badge fs-1 opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="@Url.Action("Doctors", "Admin")" class="text-white text-decoration-none small">
                    Gérer <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-1 opacity-75">Services</h6>
                        <h2 class="card-title mb-0">@Model.TotalServices</h2>
                    </div>
                    <i class="bi bi-clipboard2-pulse fs-1 opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="@Url.Action("Services", "Admin")" class="text-white text-decoration-none small">
                    Gérer <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-secondary text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-1 opacity-75">Départements</h6>
                        <h2 class="card-title mb-0">@Model.TotalDepartments</h2>
                    </div>
                    <i class="bi bi-building fs-1 opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="@Url.Action("Departments", "Admin")" class="text-white text-decoration-none small">
                    Gérer <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card bg-warning text-dark h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-1">Rendez-vous totaux</h6>
                        <h2 class="card-title mb-0">@Model.TotalAppointments</h2>
                    </div>
                    <i class="bi bi-calendar-check fs-1 opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="@Url.Action("Appointments", "Admin")" class="text-dark text-decoration-none small">
                    Gérer <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-danger text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-1 opacity-75">RDV en attente</h6>
                        <h2 class="card-title mb-0">@Model.PendingAppointments</h2>
                    </div>
                    <i class="bi bi-hourglass-split fs-1 opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="@Url.Action("Appointments", "Admin", new { status = 0 })" class="text-white text-decoration-none small">
                    Voir <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-dark text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-1 opacity-75">Revenu total</h6>
                        <h2 class="card-title mb-0">@Model.TotalRevenue.ToString("N2") MAD</h2>
                    </div>
                    <i class="bi bi-currency-dollar fs-1 opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="@Url.Action("Orders", "Admin")" class="text-white text-decoration-none small">
                    Commandes <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Appointments -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-calendar-event me-2"></i>Derniers rendez-vous</h5>
                <a href="@Url.Action("Appointments", "Admin")" class="btn btn-sm btn-outline-primary">Voir tout</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentAppointments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Patient</th>
                                    <th>Médecin</th>
                                    <th>Date</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in Model.RecentAppointments)
                                {
                                    <tr>
                                        <td>@appointment.User?.FirstName @appointment.User?.LastName</td>
                                        <td>@appointment.Doctor?.FullName</td>
                                        <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @switch (appointment.Status)
                                            {
                                                case projet_hopital.Models.AppointmentStatus.Pending:
                                                    <span class="badge bg-warning text-dark">En attente</span>
                                                    break;
                                                case projet_hopital.Models.AppointmentStatus.Confirmed:
                                                    <span class="badge bg-success">Confirmé</span>
                                                    break;
                                                case projet_hopital.Models.AppointmentStatus.Completed:
                                                    <span class="badge bg-info">Terminé</span>
                                                    break;
                                                case projet_hopital.Models.AppointmentStatus.Cancelled:
                                                    <span class="badge bg-danger">Annulé</span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-center text-muted py-4">Aucun rendez-vous récent</p>
                }
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Dernières commandes</h5>
                <a href="@Url.Action("Orders", "Admin")" class="btn btn-sm btn-outline-primary">Voir tout</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentOrders.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>N° Commande</th>
                                    <th>Client</th>
                                    <th>Montant</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td><code>@order.OrderNumber</code></td>
                                        <td>@order.User?.FirstName @order.User?.LastName</td>
                                        <td>@order.TotalAmount.ToString("N2") MAD</td>
                                        <td>
                                            @switch (order.Status)
                                            {
                                                case projet_hopital.Models.OrderStatus.Pending:
                                                    <span class="badge bg-warning text-dark">En attente</span>
                                                    break;
                                                case projet_hopital.Models.OrderStatus.Confirmed:
                                                    <span class="badge bg-primary">Confirmé</span>
                                                    break;
                                                case projet_hopital.Models.OrderStatus.Processing:
                                                    <span class="badge bg-info">En cours</span>
                                                    break;
                                                case projet_hopital.Models.OrderStatus.Completed:
                                                    <span class="badge bg-success">Terminé</span>
                                                    break;
                                                case projet_hopital.Models.OrderStatus.Cancelled:
                                                    <span class="badge bg-danger">Annulé</span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-center text-muted py-4">Aucune commande récente</p>
                }
            </div>
        </div>
    </div>
</div>

